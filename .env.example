# Copy to .env and fill in. Never commit real values.

# Neon Postgres
DATABASE_URL=
DATABASE_URL_POOLED=
# Isolated Neon branch for tests (never production)
DATABASE_TEST_URL=

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# App
APP_URL=
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=
SCOUT_TEST_MODE=

# OpenAI
OPENAI_API_KEY=
OPENAI_BRAIN_MODEL=
OPENAI_REPLY_MODEL=
OPENAI_SCORING_MODEL=
OPENAI_SCORING_REASONING_EFFORT=

# X API
X_BEARER_TOKEN=
# X OAuth 2.0 (PKCE), connect the user's own X account for private metrics.
# Confidential client ("Web App") credentials from the X developer portal.
# Callback URI to register: <APP_URL>/api/x/oauth/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Off unless "true" (needs TOKEN_ENCRYPTION_KEY too)
X_OAUTH_ENABLED=false
# Starter/Pro automatic Growth collection: off unless "true" AND a cap above 0
X_ANALYTICS_AUTO_ENABLED=false
# Automatic collections per UTC day across all of Scout (each <= 20 post reads + 1 user read)
X_ANALYTICS_AUTO_MAX_PER_DAY=0

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Paddle (public, sent to the browser)
# "sandbox" or "production"; required, there is no default
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token: test_… for sandbox, live_… for production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_STARTER_PRICE_ID=pri_
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=pri_

# Paddle server-side: the notification destination's secret key (pdl_ntfset_…)
PADDLE_WEBHOOK_SECRET=
# Paddle API key (server only): pdl_sdbx_apikey_… for sandbox, pdl_live_apikey_… for production.
# Permissions: subscriptions read/write, customer portal sessions write.
PADDLE_API_KEY=
