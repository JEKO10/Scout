# Copy to .env and fill in. Never commit real values.

# Neon Postgres
DATABASE_URL=
DATABASE_URL_POOLED=
# Isolated Neon branch for tests (never production)
DATABASE_TEST_URL=

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# App
APP_URL=
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=
SCOUT_TEST_MODE=

# OpenAI
OPENAI_API_KEY=
OPENAI_BRAIN_MODEL=
OPENAI_REPLY_MODEL=
OPENAI_SCORING_MODEL=
OPENAI_SCORING_REASONING_EFFORT=

# X API
X_BEARER_TOKEN=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Paddle (public, sent to the browser)
# "sandbox" or "production"; required, there is no default
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Client-side token: test_… for sandbox, live_… for production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_STARTER_PRICE_ID=pri_
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=pri_

# Paddle server-side: the notification destination's secret key (pdl_ntfset_…)
PADDLE_WEBHOOK_SECRET=
